# HSDEEP CORE AI - production environment TEMPLATE (Phase 9A)
#
# Every value below is a PLACEHOLDER. Copy this file to a secret-managed
# location (or load it as a Kubernetes Secret / ECS task secret), replace the
# REPLACE_ME_* values, and NEVER commit the filled-in file.
#
# With APP_ENV=production the application REFUSES TO START while any enforced
# check fails (placeholder secrets, localhost DATABASE_URL, DEBUG=true,
# FORCE_HTTPS=false, missing LOG_LEVEL, wildcard/unset CORS_ORIGINS, or
# PRTG_DEV_VERIFY_SSL=false). See deployment/README.md.

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Runtime role for THIS container: api | worker | scheduler
RUNTIME_MODE=api
SHUTDOWN_DRAIN_SECONDS=15
READINESS_REQUIRE_REDIS=true

HOST=0.0.0.0
PORT=8000
FORCE_HTTPS=true
# Explicit allow-list only - a wildcard is refused at startup in production.
CORS_ORIGINS=https://portal.example.com,https://ops.example.com

# --- Injected from the secret manager (placeholders only) -------------------
DATABASE_URL=postgresql+asyncpg://REPLACE_ME_USER:REPLACE_ME_PASSWORD@db.example.internal:5432/hsdeep
REDIS_URL=redis://REPLACE_ME_REDIS_HOST:6379/0
SECRET_ENCRYPTION_KEY=REPLACE_ME_FERNET_KEY
JWT_SECRET_KEY=REPLACE_ME_DISTINCT_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_ENFORCED=true

# --- Collectors / scheduler -------------------------------------------------
MAX_CONCURRENT_COLLECTIONS=10
COLLECTOR_RUN_STALE_MINUTES=10
# 0 disables per-source Redis rate limiting (see deployment/README.md).
SOURCE_RATE_LIMIT_RPM=0
SOURCE_RATE_LIMIT_TTL_SECONDS=120

# --- Local LLM (optional) ---------------------------------------------------
OLLAMA_HOST=http://ollama.example.internal:11434
OLLAMA_MODEL=qwen3.6:latest

# --- PRTG collectors (only if used; credentials from the secret provider) ---
PRTG_DEV_URL=
PRTG_DEV_USERNAME=
PRTG_DEV_PASSHASH=
PRTG_DEV_VERIFY_SSL=true

# --- Billing (optional) -----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
\n
# ---------------------------------------------------------------------------
# Unified observability (Phase 22): logs, traces and their search.
# deployment/observability/README.md describes the stack these point at.
# All are internal URLs, read server-side only, never sent to the browser.
# Leave a value empty to turn that part off: the Platform Observability page
# then shows NOT AVAILABLE for it instead of an empty result.
# ---------------------------------------------------------------------------
# OTLP/HTTP base URL of the OpenTelemetry Collector. Empty = spans and logs
# are not exported (trace ids still appear in stdout logs).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=hsdeep-backend
# Share of new traces recorded, 0.0 - 1.0. Lower it on a busy production API.
OTEL_TRACES_SAMPLER_RATIO=0.1
# Also export log records over OTLP (needs the endpoint above).
OTEL_LOGS_EXPORT=true
# Loki (Logs Explorer), Tempo (Trace Explorer), collector health_check.
# LOKI_URL=http://loki:3100
# TEMPO_URL=http://tempo:3200
# OTEL_COLLECTOR_HEALTH_URL=http://otel-collector:13133
# Limits for the superuser Logs / Trace explorers.
OBSERVABILITY_QUERY_TIMEOUT_SECONDS=8
OBSERVABILITY_MAX_WINDOW_HOURS=168
OBSERVABILITY_QUERIES_PER_MINUTE=60
