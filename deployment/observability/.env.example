# Copy to .env next to docker-compose.yml. No secrets here: the metrics token
# and the Grafana admin password are files under ./secrets (git ignored).

# Pinned images. Change deliberately, after reading the release notes.
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.1.1

# prometheus.yml (development: scrapes the backend on the host) or
# prometheus.production.yml (Kubernetes pod discovery of api / worker / scheduler).
PROMETHEUS_CONFIG=prometheus.yml

# How long Prometheus keeps data; the first limit reached wins.
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB

# Host ports, bound to 127.0.0.1 only. 3002 avoids the Next.js dev server on 3000.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=http://localhost:3002

# --- Phase 22: logs, traces, infrastructure metrics -----------------------------
LOKI_VERSION=3.5.1
TEMPO_VERSION=2.8.1
OTEL_COLLECTOR_VERSION=0.130.0
NODE_EXPORTER_VERSION=v1.9.1
CADVISOR_VERSION=v0.52.1
POSTGRES_EXPORTER_VERSION=v0.17.1
REDIS_EXPORTER_VERSION=v1.74.0-alpine
BUSYBOX_VERSION=1.37.0
# Only with `--profile gpu` (NVIDIA GPU hosts).
DCGM_EXPORTER_VERSION=4.2.3-4.1.3-ubuntu22.04

# How long logs and traces are kept (Go durations, hours).
LOKI_RETENTION=168h
TEMPO_RETENTION=168h

# Host ports, bound to 127.0.0.1 only. The backend on the host uses them:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
#   OTEL_COLLECTOR_HEALTH_URL=http://127.0.0.1:13133
#   LOKI_URL=http://127.0.0.1:3100   TEMPO_URL=http://127.0.0.1:3200
OTLP_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
LOKI_PORT=3100
TEMPO_PORT=3200

# Stamped on container logs (application logs carry the backend's APP_ENV).
HSDEEP_ENVIRONMENT=development

# The HSDEEP database and Redis the exporters read. No passwords here:
#   secrets/postgres_exporter_password        the monitoring role's password
#   secrets/redis_exporter_passwords.json     {} or {"redis://host:6379": "password"}
POSTGRES_EXPORTER_URI=host.docker.internal:5432/hsdeep?sslmode=disable
POSTGRES_EXPORTER_USER=hsdeep_monitor
REDIS_EXPORTER_ADDR=redis://host.docker.internal:6379

# Container logs (Linux Docker hosts only). Leave both unset to collect none.
# DOCKER_CONTAINERS_DIR=/var/lib/docker/containers
# OTEL_COLLECTOR_USER=0
