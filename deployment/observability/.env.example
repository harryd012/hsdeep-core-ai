# Copy to .env next to docker-compose.yml. No secrets here: the metrics token
# and the Grafana admin password are files under ./secrets (git ignored).

# Pinned images. Change deliberately, after reading the release notes.
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.1.1

# prometheus.yml (development: scrapes the backend on the host) or
# prometheus.production.yml (Kubernetes pod discovery of api / worker / scheduler).
PROMETHEUS_CONFIG=prometheus.yml

# How long Prometheus keeps data; the first limit reached wins.
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB

# Host ports, bound to 127.0.0.1 only. 3002 avoids the Next.js dev server on 3000.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=http://localhost:3002
