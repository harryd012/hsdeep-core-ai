# Secret files live here and are never committed:
#   metrics_token            - same value as the backend's METRICS_BEARER_TOKEN
#   grafana_admin_password   - Grafana's first-run admin password
#   postgres_exporter_password      - password of the read-only monitoring role
#   redis_exporter_passwords.json   - {} or {"redis://host:6379": "password"}
*
!.gitignore
