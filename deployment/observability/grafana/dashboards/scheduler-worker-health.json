    {
      "id": 10,
      "type": "timeseries",
      "title": "DB pool connections",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hsdeep-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "sum by (component) (hsdeep_db_pool_checked_out{component=~\"$component\"})",
          "legendFormat": "{{component}} checked out",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "sum by (component) (hsdeep_db_pool_size{component=~\"$component\"} + hsdeep_db_pool_max_overflow{component=~\"$component\"})",
          "legendFormat": "{{component}} capacity",
          "refId": "B",
          "range": true,
          "instant": false
        }
