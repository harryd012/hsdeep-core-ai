{
  "uid": "hsdeep-collectors",
  "title": "HSDEEP \u00b7 Collector Operations",
  "description": "Collection pipeline outcomes and performance by source type.",
  "tags": [
    "hsdeep-platform"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": [
      "15s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "component",
        "label": "Process role",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "hsdeep-prometheus"
        },
        "query": {
          "query": "label_values(hsdeep_build_info, component)",
          "refId": "component"
        },
        "definition": "label_values(hsdeep_build_info, component)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "source_type",
        "label": "Source type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "hsdeep-prometheus"
        },
        "query": {
          "query": "label_values(hsdeep_collection_run_total, source_type)",
          "refId": "source_type"
        },
        "definition": "label_values(hsdeep_collection_run_total, source_type)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "hsdeep-platform"
      ],
      "asDropdown": true,
      "title": "HSDEEP Platform",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Outcomes",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs (range)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hsdeep-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "sum(increase(hsdeep_collection_run_total{status=~\"success|error\", component=~\"$component\", source_type=~\"$source_type\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Not measured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Success rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hsdeep-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "sum(increase(hsdeep_collection_run_total{status=\"success\", component=~\"$component\", source_type=~\"$source_type\"}[$__range])) / sum(increase(hsdeep_collection_run_total{status=~\"success|error\", component=~\"$component\", source_type=~\"$source_type\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Not measured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
