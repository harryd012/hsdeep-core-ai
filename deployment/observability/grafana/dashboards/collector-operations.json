      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "sum by (phase) (rate(hsdeep_collector_phase_duration_seconds_sum{component=~\"$component\", source_type=~\"$source_type\"}[15m])) / sum by (phase) (rate(hsdeep_collector_phase_duration_seconds_count{component=~\"$component\", source_type=~\"$source_type\"}[15m]))",
          "legendFormat": "{{phase}}",
          "refId": "A",
