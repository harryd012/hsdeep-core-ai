    {
      "id": 9,
      "type": "timeseries",
      "title": "Run duration p50 / p95 / p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hsdeep-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(hsdeep_collection_run_duration_seconds_bucket{component=~\"$component\", source_type=~\"$source_type\"}[15m])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hsdeep_collection_run_duration_seconds_bucket{component=~\"$component\", source_type=~\"$source_type\"}[15m])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hsdeep_collection_run_duration_seconds_bucket{component=~\"$component\", source_type=~\"$source_type\"}[15m])))",
          "legendFormat": "p99",
          "refId": "C",
          "range": true,
          "instant": false
