      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "time() - max(hsdeep_scheduler_last_tick_timestamp_seconds > 0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
