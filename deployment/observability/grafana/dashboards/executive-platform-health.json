    {
      "id": 14,
      "type": "timeseries",
      "title": "Requests and errors",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "hsdeep-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
