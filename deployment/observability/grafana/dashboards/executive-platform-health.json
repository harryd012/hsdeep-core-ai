      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "hsdeep-prometheus"
          },
          "expr": "sum(rate(hsdeep_collection_run_total{status=\"success\", component=~\"$component\"}[1h])) / sum(rate(hsdeep_collection_run_total{status=~\"success|error\", component=~\"$component\"}[1h]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Not measured",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Scheduler last tick",
      "description": "Age of the newest scheduler tick across every process. Ticks run each minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "hsdeep-prometheus"
