# Copy this file to .env and fill in real values.
# NEVER commit a filled-in .env — .gitignore already excludes .env / .env*.local.
#
# If backend/.env has ever been committed to this repo's git history with
# real secrets in it, those secrets are compromised (visible in history even
# after deletion) and MUST be rotated — see PRODUCTION_READINESS.md P0-4.

# --- App -----------------------------------------------------------------
APP_NAME=hsdeep-core-ai-backend
# development | staging | production
# Setting production triggers Settings.validate_for_production() at startup
# (app/core/config.py) — the app will refuse to boot with placeholder
# secrets, a localhost DATABASE_URL, or DEBUG=true. See app/main.py startup_event.
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- CORS --------------------------------------------------------------
# Comma-separated allow-list, e.g.: https://app.example.com,https://example.com
# REQUIRED and enforced (startup fails without it) when APP_ENV=production.
# In development, if left unset, defaults to http://localhost:3000.
CORS_ORIGINS=

# --- Database / Cache ------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hsdeep
REDIS_URL=redis://localhost:6379/0

# --- Secrets -----------------------------------------------------------
# Fernet key used to encrypt vendor credentials (monitoring source
# passwords/API keys) at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED — the app will not start without this set (no default, by design).
SECRET_ENCRYPTION_KEY=changeme-generate-a-fernet-key

# JWT signing secret. If left unset, falls back to SECRET_ENCRYPTION_KEY
# (fine for a single dev box; validate_for_production() REJECTS this
# fallback in production — set a distinct high-entropy value there).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Master switch for the auth cutover — leave true. See core/config.py docstring.
AUTH_ENFORCED=true

# --- Collectors / Scheduler --------------------------------------------
MAX_CONCURRENT_COLLECTIONS=10
COLLECTOR_RUN_STALE_MINUTES=10

# --- Runtime role (Phase 9A deployment contract) --------------------------
# One image, several roles:
#   all       - local development: HTTP + scheduler + RCA/EventBus consumers
#   api       - HTTP only: no scheduler jobs, no in-process event consumers
#   worker    - background: scheduler ticks + RCA/EventBus consumers
#   scheduler - background: scheduler ticks only
# The collection tick already takes a Postgres advisory lock, so it is
# single-owner even if several processes try; the api role simply never starts
# it. See deployment/README.md for the api/worker/scheduler commands.
RUNTIME_MODE=all
# Bounded shutdown drain budget (seconds) for queued background work.
SHUTDOWN_DRAIN_SECONDS=15
# Redis counts toward /health/ready by default (ready = database AND redis).
# Set false only if this deployment intentionally runs without Redis.
READINESS_REQUIRE_REDIS=true
# text (default) | json. json emits one JSON object per line for centralized log
# shipping; request logs then expose method/route/status/duration_ms/
# correlation_id/tenant_id/user_id as first-class keys. See
# deployment/OBSERVABILITY.md.
LOG_FORMAT=text

# --- Per-source collection rate limiting (optional) ------------------------
# 0 = DISABLED (default). When > 0, a Redis sliding window limits how often each
# monitoring source is collected across ALL worker processes, so two workers
# cannot poll the same source concurrently. Redis failures FAIL OPEN - a source
# is never starved because Redis is unavailable.
SOURCE_RATE_LIMIT_RPM=0
SOURCE_RATE_LIMIT_TTL_SECONDS=120

# --- Diagnostic scripts (optional) -----------------------------------------
# backend/*.py diagnostics and smoke tests take their credentials from
# SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD below (no credential is committed).
# test_auth.py additionally accepts a rotated-out signing key here.
OLD_JWT_SECRET_KEY=

# --- Billing (Stripe) ----------------------------------------------------
# Leave both empty to disable billing/webhook endpoints in dev
# (POST /api/stripe/webhook returns 501 when STRIPE_WEBHOOK_SECRET is empty).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Local LLM (Ollama) — used by AI Copilot chat + insight summarization only
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.6:latest
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_SUMMARY_TIMEOUT_SECONDS=150
# Optional per-tier model routing — leave empty to use OLLAMA_MODEL for everything.
AI_FAST_MODEL=
AI_STANDARD_MODEL=
AI_DEEP_MODEL=
# Optional Ollama keep_alive duration string (e.g. "5m", "-1"). Empty = Ollama default.
OLLAMA_KEEP_ALIVE=

# --- Security headers -----------------------------------------------------
# Only set true once the deployment is confirmed to be served over HTTPS
# (e.g. behind a TLS-terminating reverse proxy). Enables HSTS. See main.py.
FORCE_HTTPS=false

# --- PRTG dev server (optional — used only by scripts/seed_dev_prtg_source.py
# and manual verification against a real PRTG box; never commit real values) ---
PRTG_DEV_HOST=
PRTG_DEV_PORT=443
PRTG_DEV_PROTOCOL=https
PRTG_DEV_USERNAME=
PRTG_DEV_PASSHASH=
PRTG_DEV_VERIFY_SSL=false
PRTG_DEV_POLL_INTERVAL_SECONDS=60
# Combined-URL form used by scripts/seed_prtg_dev.py
PRTG_DEV_URL=

# --- Dev seed data (scripts/seed_dev_prtg_source.py) -----------------------
# Refuses to run under APP_ENV=production regardless of these values.
SEED_TENANT_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
