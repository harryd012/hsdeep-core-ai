# Template for the dedicated PostgreSQL test database (local developer setup).
#
# Copy this file to backend/.env.test (gitignored - the real URL with the real
# test-role password never ships) and fill in the password. ci/quality_gates.sh
# loads backend/.env.test for its DB-backed backend gates; tests/conftest.py
# refuses to run when TEST_DATABASE_URL is unset so DB-writing tests can never
# mutate the dev database (backend/.env DATABASE_URL).
#
# One-time provisioning (as the postgres superuser):
#   CREATE ROLE test LOGIN PASSWORD 'REPLACE_ME_PG_PASSWORD';
#   CREATE DATABASE hsdeep_test OWNER test;
# Then migrate it:  DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/hsdeep_test alembic upgrade head
#
# Keep this OUT of backend/.env: app/core/db.py selects
# `test_database_url or database_url`, so putting TEST_DATABASE_URL in .env would
# make the normal dev application bind to the empty test database instead of hsdeep.
TEST_DATABASE_URL=postgresql+asyncpg://test:REPLACE_ME_PG_PASSWORD@127.0.0.1:5432/hsdeep_test
